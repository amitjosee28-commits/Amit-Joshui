{
  "rules": {
    ".read": "false",
    ".write": "false",
    "portfolio": {
      ".read": "true",
      ".write": "auth != null"
    },
    "suggestions": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$suggestion_id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'message', 'timestamp']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('message').isString() && newData.child('message').val().length > 0 && newData.child('timestamp').isString()"
      }
    },
    "service_applications": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$app_id": {
        ".read": "true",
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['serviceId', 'serviceTitle', 'name', 'contact', 'email', 'timestamp']) && newData.child('serviceId').isString() && newData.child('serviceTitle').isString() && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('contact').isString() && newData.child('email').isString() && newData.child('timestamp').isString()"
      }
    },
    "service_submissions": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$submission_id": {
        ".read": "true",
        ".write": "!data.exists() && newData.exists()"
      }
    },
    "invoices": {
      ".read": "true",
      ".write": "auth != null",
      "$invoice_id": {
        ".read": "true",
        ".write": "!data.exists() && newData.exists()"
      }
    },
    "newsletter_subscribers": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$subscriber_id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['email', 'subscribedAt']) && newData.child('email').isString() && newData.child('subscribedAt').isString()"
      }
    },
    "subscribers": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$sub_id": {
        ".write": "!data.exists() && newData.exists()"
      }
    },
    "site_stats": {
      ".read": "true",
      ".write": "auth != null",
      "visits": {
        ".write": "true"
      }
    },
    "admin": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
